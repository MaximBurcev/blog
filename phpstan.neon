includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Уровень 5: на 6+ лавина «нет типа у параметра/возврата» по всему app/
    # (проект писался без строгой типизации), а 5 ловит уже реальные ошибки —
    # несуществующие методы, неверное число аргументов, неопределённые переменные.
    # Существующие срабатывания зафиксированы в phpstan-baseline.neon —
    # зелёный прогон означает «не стало хуже», новые ошибки ловятся сразу.
    level: 5
    paths:
        - app/
