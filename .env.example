APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# info, а не debug: на уровне debug пайплайн парсинга пишет в лог сырые URL
# источников, CSS-селекторы, построенные XPath и пути к файлам. На проде это
# лишняя поверхность (логи читаются через /log-viewer). Локально можно debug.
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_AFTER_COMMIT=true
MEILISEARCH_HOST=http://meilisearch:7700
# Обязательно задать: с пустым MEILI_MASTER_KEY Meilisearch стартует вообще
# без авторизации, и индекс читается и перезаписывается кем угодно, у кого
# есть доступ к порту.
MEILISEARCH_KEY=
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_NO_SENTRY=true
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Security-заголовки (config/security.php)
# HSTS уходит только на HTTPS-ответах; includeSubDomains/preload включать,
# только когда все поддомены точно под сертификатом — откат ждать max_age
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# CSP_REPORT_ONLY=true — обкатка ужесточённой политики без блокировок
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
# Дополнительные разрешённые источники (новая CDN, счётчик), через запятую
CSP_EXTRA_HOSTS=

# Дебаг-панели. Дефолт в конфигах — отключено (fail-closed):
# включать точечно на dev, в проде оставлять пустыми/false.
# Доступ к /log-viewer и /telescope дополнительно закрыт гейтами
# viewLogViewer / viewTelescope (роль Admin).
LOG_VIEWER_ENABLED=false
TELESCOPE_ENABLED=false

# Broadcasting (Reverb). REVERB_ALLOWED_ORIGINS — список ХОСТОВ через запятую,
# без схемы и порта: Reverb сравнивает паттерн с parse_url($origin, PHP_URL_HOST).
# Если не задать — берётся хост из APP_URL.
REVERB_ALLOWED_ORIGINS=

# Headless-браузер (FlareSolverr) для обхода antibot-проверок с исполнением JS —
# нужен medium.com, где Cloudflare managed challenge недостижим для curl.
# Пусто = выключено, парсер работает как прежде.
# Контейнер поднимается командой ./vendor/bin/envoy run challenge-solver
FLARESOLVERR_URL=
FLARESOLVERR_TIMEOUT=120

# Бэкапы (spatie/laravel-backup). Расписание — в app/Console/Kernel.php, но оно
# работает только если на сервере заведён cron: ./vendor/bin/envoy run scheduler-cron
#
# Без пароля архив создаётся НЕЗАШИФРОВАННЫМ, а внутри — дамп users с почтами и
# bcrypt-хэшами. Задавайте на всех боевых стендах и храните пароль ВНЕ сервера:
# он лежит в этом же .env, который при потере машины пропадёт вместе с ней.
BACKUP_ARCHIVE_PASSWORD=
# Куда слать письма о провалившемся или протухшем бэкапе (backup:monitor)
BACKUP_NOTIFICATION_EMAIL=
# Имя каталога с архивами. Не APP_NAME: пробелы и кириллица в пути ломают
# ручной rsync/scp при восстановлении.
BACKUP_NAME=blog

# Sentry: трекер ошибок. Без DSN интеграция превращается в no-op, поэтому
# локально и в CI переменная пуста. Ключ берётся в самом Sentry
# (Settings -> Projects -> Client Keys).
SENTRY_LARAVEL_DSN=

# Перевод статей. Основной движок — Gemini; при его недоступности
# TranslateService молча падает на прежний скрейпер translate.google.com,
# а имя сработавшего движка пишется в posts.translated_by.
TRANSLATION_DRIVER=gemini
TRANSLATION_FALLBACK=true
GEMINI_API_KEY=
# gemini-2.5-flash новым проектам больше не выдаётся
GEMINI_MODEL=gemini-3.6-flash
# Нужен только там, где регион не поддерживается: с машины разработчика
# API отвечает «User location is not supported». Прод в Нидерландах — ему
# прокси не нужен. Локально: ssh -D 1080 deployer@<прод>
GEMINI_PROXY=
