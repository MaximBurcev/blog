<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_DATABASE" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!--
            Тесты не ходят в Meilisearch. Раньше драйвер брался из .env: прогон
            молча зависел от поднятого рядом контейнера поиска, а в чистом
            окружении (CI) упал бы на первом же посте, созданном без
            withoutSyncingToSearch. Содержимое документа проверяется напрямую
            через toSearchableArray (PostSearchableArrayTest) — живой индекс
            для этого не нужен.
        -->
        <env name="SCOUT_DRIVER" value="null"/>
        <!-- Кэш конфига в CI не собирается, а вот локальный .env может
             оказаться каким угодно: фиксируем соединение явно. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <!--
            Дальше — то, что тесты проверяют по существу и что до сих пор
            бралось из .env разработчика. На машине, где эти значения были
            выставлены руками, всё зеленело; в чистом окружении по .env.example
            четыре теста падали, и нашёл это первый же прогон CI.

            log-viewer: три теста проверяют, кого пускать к логам, — для этого
            сам просмотрщик должен быть включён, иначе маршрут отдаёт 404 и
            «гостя не пустило» становится ложноположительным.
        -->
        <env name="LOG_VIEWER_ENABLED" value="true"/>
        <!--
            Broadcast: DraftPostAccessTest проверяет, что приватный канал
            черновика не авторизуется. С драйвером log из .env.example
            /broadcasting/auth отвечает 200 на что угодно, и проверка теряет
            смысл. Берём тот же драйвер, что на проде.
        -->
        <env name="BROADCAST_DRIVER" value="reverb"/>
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <!--
            Ключи фиктивные и нужны только чтобы драйвер сконструировался:
            /broadcasting/auth никуда не ходит по сети, он лишь сверяет канал с
            правилами из routes/channels.php. Без них Pusher-клиент падает на
            null вместо строки — и роняет не один тест, а весь прогон.
        -->
        <env name="REVERB_APP_ID" value="testing"/>
        <env name="REVERB_APP_KEY" value="testing"/>
        <env name="REVERB_APP_SECRET" value="testing"/>
    </php>
</phpunit>
